/target
**/*.rs.bk

# The management UI (P4) is built by the Dockerfile's `node` stage, not
# committed pre-built — `web/dist/.gitkeep` is what's tracked instead, so a
# fresh checkout still has the empty directory `rust-embed`'s derive macro
# needs to exist at compile time (see src/control/ui.rs). `cargo build`
# never runs `npm`, so this directory being empty locally is the normal,
# expected state, not a broken one.
/web/dist/*
!/web/dist/.gitkeep
/web/node_modules

# `fastembed` (bench only) caches ONNX weights here — 213MB of them, which a
# `git add -A` from the repo root will happily commit and which then fails the
# push with an HTTP 408 rather than anything that names the cause.
.fastembed_cache/

# Screenshots from `npm run test:browser` — build output of a check, not source.
/web/.screenshots/
book/
mermaid.min.js
mermaid-init.js
